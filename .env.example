# The worker's settings. Copy this file to .env and fill it in; .env is never committed.
# The live copy's scripts (scripts/live/) read COURTYARD_DATA_DIR and COURTYARD_PORT from it too.

# The context folder, holding every workspace. It must already exist; the worker makes it a git
# repository and commits every change to it.
COURTYARD_CONTEXT_DIR=/path/to/context
# Where the context folder is backed up: any git remote, such as a bare repository in a shared
# folder (//nas.example/courtyard/context.git). Leave it out for no backup (ADR 0014).
# COURTYARD_CONTEXT_REMOTE=//nas.example/courtyard/context.git
# Where the worker keeps sessions, logins and its logs. Created if it's missing.
COURTYARD_DATA_DIR=/path/to/data
# The port the worker listens on, behind your HTTPS proxy.
COURTYARD_PORT=8787
# 0 leaves Claude out; 1 (the default) offers it through this machine's Claude Code login.
COURTYARD_CLAUDE_PROVIDER=1
# 1 offers the scripted fake provider, for trying Courtyard with no model.
COURTYARD_FAKE_PROVIDER=0
# 1 makes the fake act signed out, with a pretend sign-in on the home page that finishes by itself.
COURTYARD_FAKE_SIGN_IN=0
# 1 offers a second fake, "Fake two", to carry on with after a pretend usage limit.
COURTYARD_SECOND_FAKE_PROVIDER=0
# The client ID of the GitHub App Courtyard signs in to GitHub through, so code sessions can push
# and open pull requests (README, GitHub). Leave it out until you've registered the app.
# COURTYARD_GITHUB_CLIENT_ID=Iv23liExampleClientId
# COURTYARD_LIVE_COPY and COURTYARD_UPDATE_TASK turn on updating from the app. Leave them out:
# scripts/live/run.ps1 sets them when it starts a live copy's worker (ADR 0011).
