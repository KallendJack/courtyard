{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "noParameterAssign": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.md", "**/*.yaml", "**/*.yml"],
      "formatter": { "enabled": false }
    }
  ]
}
